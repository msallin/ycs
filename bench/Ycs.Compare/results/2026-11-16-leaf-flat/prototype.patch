@@ -139,6 +139,40 @@ internal sealed partial class ClientStructs
     /// </summary>
     internal void Refresh(int index)
     {
+        if (_flatStructs != null)
+        {
+            var item = _flatStructs[index];
+            byte f;
+            if (!item.IsItem)
+            {
+                f = Break;
+            }
+            else
+            {
+                var before = index > 0 ? _flatStructs[index - 1] : default;
+                f = before.IsItem && item.Left == before ? (byte)0 : Break;
+                if (!item.Deleted)
+                {
+                    f |= item.Countable ? Visible : Format;
+                }
+            }
+
+            var was = _flatFlags[index];
+            if (was == f)
+            {
+                return;
+            }
+
+            var length = (index + 1 < _count ? _flatStarts[index + 1] : _end) - _flatStarts[index];
+            SetFlags(0, index, f);
+            if (((was ^ f) & Visible) != 0)
+            {
+                AddSum(0, (f & Visible) != 0 ? length : -length);
+            }
+
+            return;
+        }
+
         var k = Locate(index, out var i);
         var old = ValueAt(k, i);
         SetFlags(k, i, FlagsAt(k, i));
