<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Ycs.Fuzz</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Fully optimized code from the first call: whether a method is inlined decides which frame
         an exception's throw site is, and a violation's signature includes it. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ycs\Ycs.csproj" />
  </ItemGroup>

  <!-- The item-list invariants of tests/Ycs.Corpus, for Consistency. -->
  <ItemGroup>
    <Compile Include="..\Ycs.Corpus\ItemListInvariants.cs" Link="Shared\ItemListInvariants.cs" />
  </ItemGroup>

  <!-- Seeds: the updates recorded from real Yjs (interop/corpus/cases), read only. -->
  <ItemGroup>
    <None Include="..\..\interop\corpus\cases\*.json" Link="cases\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
