<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Ycs.Budgets</RootNamespace>
    <!-- Fully optimized code from the first call: no tier-up in the middle of a measurement, so the
         allocation counts do not depend on timing. -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ycs\Ycs.csproj" />
  </ItemGroup>

</Project>
