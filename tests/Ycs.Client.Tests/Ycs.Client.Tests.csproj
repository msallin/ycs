<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test names are Method_Scenario_Result. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\samples\Ycs.Client\Ycs.Client.csproj" />
    <!-- Built first and run as a process: its types are internal to it and its own tests. -->
    <ProjectReference Include="..\..\samples\Ycs.Server\Ycs.Server.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ServerAssembly</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../samples/Ycs.Server/bin/$(Configuration)/net11.0/Ycs.Server.dll</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
