<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <Nullable>enable</Nullable>
    <!-- An ItemRef compared with null binds to the lifted operator and is always false: compare with IsNull. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8073</WarningsAsErrors>
    <Version>0.0.1</Version>
    <Description>.NET implementation of the Yjs CRDT framework.</Description>
    <Copyright>Copyright (c) 2021</Copyright>
    <PackageProjectUrl>https://github.com/yjs/ycs/</PackageProjectUrl>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/yjs/ycs/</RepositoryUrl>
    <PackageTags>Yjs, Ycs, CRDT, offline, shared editing, concurrency, collaboration</PackageTags>
    <AssemblyVersion>0.0.1.0</AssemblyVersion>
    <Authors>Aleksey Kabanov</Authors>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
